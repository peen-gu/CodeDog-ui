{
  "name": "codedogui-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "CodeDogUI - 面向 uni-app 的跨端 UI 框架（H5 移动 + H5 PC + 微信小程序 + Electron 桌面）。由 Codedog.tech 长期维护，UI 作者 Penn.Gu。",
  "author": "Penn.Gu (https://ui.codedog.tech)",
  "license": "MIT",
  "homepage": "https://ui.codedog.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peen-gu/CodeDog-ui.git"
  },
  "bugs": {
    "url": "https://github.com/peen-gu/CodeDog-ui/issues",
    "email": "codedog.tech@icloud.com"
  },
  "_codedog": {
    "team": "Codedog.tech",
    "site": "https://ui.codedog.tech",
    "docs": "https://doc.ui.codedog.tech",
    "author": "Penn.Gu"
  },
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "docs:gen": "node scripts/gen-component-docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/gen-component-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pack:lib": "cd src/uni_modules/codedog-ui && npm pack --dry-run",
    "release:check": "cd src/uni_modules/codedog-ui && npm pack --dry-run",
    "release:publish": "cd src/uni_modules/codedog-ui && npm publish",
    "release:interactive": "node scripts/publish.mjs",
    "package:dcloud": "node scripts/package-dcloud.mjs",
    "electron:dev": "cross-env CD_ELECTRON_DEV=1 electron electron/main.js",
    "electron:start": "electron electron/main.js",
    "electron:build": "npm run build:h5 && npm run electron:start"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "^3.4.21",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "^3.4.21",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "rollup": "4.14.3",
    "sass": "1.77.8",
    "vite": "5.2.8",
    "vitepress": "^1.6.4"
  }
}
