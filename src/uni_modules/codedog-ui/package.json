          "QQ": "n"
        },
        "快应用": {
          "华为快应用": "n",
          "快应用联盟": "n"
        },
        "鸿蒙": {
          "harmony-vue3": "n"
        }
      },
      "server": {
        "aliyun": "n",
        "tencent": "n"
      }
    }
  }
}
