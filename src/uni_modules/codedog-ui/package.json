{
  "name": "codedog-ui",
  "id": "codedog-ui",
  "displayName": "CodeDogUI 跨端组件库",
  "version": "0.5.3",
  "description": "面向 uni-app 的跨端 UI 框架。一套 Vue3 代码同时覆盖 H5 移动端、H5 PC 浏览器、微信小程序与 Electron 桌面套壳；通过 Design Tokens + 平台适配层 + 双形态组件三层架构，让同一组件在手机与 PC 上呈现各自的交互形态。",
  "keywords": [
    "uni-app",
    "uni_modules",
    "vue3",
    "vue",
    "ui",
    "component-library",
    "components",
    "组件库",
    "跨端",
    "移动端",
    "小程序",
    "骨架屏",
    "设计令牌",
    "design-tokens"
  ],
  "author": {
    "name": "Penn.Gu",
    "email": "codedog.tech@icloud.com",
    "url": "https://ui.codedog.tech"
  },
  "contributors": [
    {
      "name": "Penn.Gu",
      "email": "codedog.tech@icloud.com",
      "url": "https://ui.codedog.tech",
      "role": "UI 作者"
    }
  ],
  "license": "MIT",
  "homepage": "https://ui.codedog.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peen-gu/CodeDog-ui.git"
  },
  "bugs": {
    "url": "https://github.com/peen-gu/CodeDog-ui/issues",
    "email": "codedog.tech@icloud.com"
  },
  "_codedog": {
    "team": "Codedog.tech",
    "site": "https://ui.codedog.tech",
    "docs": "https://doc.ui.codedog.tech",
    "author": "Penn.Gu"
  },
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./styles": "./styles/index.scss",
    "./styles/*": "./styles/*",
    "./components/*": "./components/*",
    "./composables/*": "./composables/*",
    "./utils/*": "./utils/*",
    "./theme/*": "./theme/*",
    "./service": "./service/index.js",
    "./changelog": "./changelog.md",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "composables",
    "service",
    "utils",
    "theme",
    "styles",
    "constants.js",
    "index.js",
    "index.d.ts",
    "changelog.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "uni-app": ">=3.0.0-5020620260917001"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "wot-design-uni": "1.14.0"
  },
  "dcloudext": {
    "type": "component-vue",
    "category": [
      "前端组件",
      "通用组件"
    ],
    "sale": {
      "regular": {
        "price": "0.00"
      },
      "sourcecode": {
        "price": "0.00"
      }
    },
    "contact": "https://ui.codedog.tech",
    "declaration": {
      "ads": "无",
      "data": "无",
      "permissions": "无",
      "notices": "无"
    }
  },
  "uni_modules": {
    "dependencies": ["wot-design-uni"],
    "encrypt": [],
    "platforms": {
      "cloud": {
        "tcb": "n",
        "aliyun": "n"
      },
      "client": {
        "Vue": {
          "vue2": "n",
          "vue3": "y"
        },
        "App": {
          "app-vue": "n",
          "app-nvue": "n"
        },
        "H5-mobile": {
          "Safari": "y",
          "Android Browser": "y",
          "微信浏览器(Android)": "y",
          "QQ浏览器(Android)": "y"
        },
        "H5-pc": {
          "Chrome": "y",
          "IE": "n",
          "Edge": "y",
          "Firefox": "y",
          "Safari": "y"
        },
        "小程序": {
